# Netlify Environment Variables
# Copy these to Netlify Dashboard → Site Settings → Environment Variables
# Do NOT commit real values to git

# AI Provider: nvidia | nebius | groq | custom
AI_PROVIDER=nvidia

# API Key for the chosen provider (REQUIRED for AI review)
AI_API_KEY=your-api-key-here

# Optional overrides
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=nvidia/nemotron-3-super-120b-a12b
# AI_TIMEOUT_SECONDS=45
# AI_MAX_OUTPUT_TOKENS=900
# AI_MAX_INPUT_CHARS=6000

# ShareSentry settings
SHARESENTRY_DATA_DIR=./data
SHARESENTRY_MAX_UPLOAD_MB=10