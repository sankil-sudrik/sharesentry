# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Which OpenAI-compatible provider to use: nvidia | nebius | groq | custom
#   nvidia -> NVIDIA API Catalog, default model nvidia/nemotron-3-super-120b-a12b (Nemotron Super)
#   nebius -> Nebius Token Factory, default model nvidia/Nemotron-3-Ultra
#   groq   -> Groq. NOTE: Groq's catalog has no Nemotron model, so this is NOT a Nemotron setup.
#   custom -> set AI_BASE_URL and AI_MODEL yourself
AI_PROVIDER=nvidia
AI_API_KEY=paste-your-key-here

# Optional overrides (defaults come from the provider preset)
# AI_BASE_URL=
# AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_INPUT_CHARS=6000

# Local storage and limits
SHARESENTRY_DATA_DIR=./data
SHARESENTRY_MAX_UPLOAD_MB=10
